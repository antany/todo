# Build the jar first (it bundles the React app): ./gradlew :backend:bootJar
#   single arch:  podman build -f podman/Containerfile -t localhost/todo-app:latest .
#   multi arch:   scripts/build-multiarch.sh   (linux/amd64 + linux/arm64)
# No RUN steps on purpose: the jar is architecture-neutral, so a cross-arch build needs no QEMU emulation.
FROM docker.io/library/eclipse-temurin:25-jre
COPY backend/build/libs/backend-0.1.0.jar /app/app.jar
# Unprivileged numeric user (no passwd entry needed; the jar is world-readable).
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
